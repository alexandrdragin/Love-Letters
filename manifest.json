{
  "manifest_version": 3,
  "name": "Love-Letters",
  "version": "1.2.0",
  "description": "Stay positive and save your aura from toxic vibes by hiding or replacing selected Discord and GitHub messages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Love-Letters",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://github.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
